# Copy to .env and fill in real values. `.env` is gitignored / dockerignored.

# === Groq (required) ===
GROQ_API_KEY=
GROQ_INTENT_MODEL=openai/gpt-oss-20b
GROQ_REWRITER_MODEL=openai/gpt-oss-20b
GROQ_PLANNER_MODEL=llama-3.3-70b-versatile

# === LangSmith tracing (optional) ===
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fitness-ai-agent

# === Qdrant / Redis ===
# In docker-compose these are overridden to the service names (qdrant, redis).
# For host-mode runs:
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379

# === Semantic cache tuning ===
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_INDEX_NAME=chat_semcache
SEMANTIC_CACHE_DISTANCE_THRESHOLD=0.1
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_EMBED_MODEL=BAAI/bge-small-en-v1.5

# === Retrieval ===
USE_HYBRID=false
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_POOL=30
